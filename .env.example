# Browser-safe values from Supabase > Project Settings > API.
# Copy to .env.local for local development and add both to Vercel before building.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Never add a secret/service-role key to a VITE_ variable.

# Server-only Google Sheets RSVP connection (see docs/google-sheets-rsvp.md).
# Do not prefix these with VITE_. Leave unset to retain local preview mode.
RSVP_SHEETS_WEBHOOK_URL=
RSVP_SHEETS_SECRET=
RSVP_SITE_ORIGIN=https://paul-and-roselyn-wedding.vercel.app
